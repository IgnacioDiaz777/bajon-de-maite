# ==========================================================
# Copia este archivo como ".env" y completa TUS datos.
# El archivo .env NO se sube al repositorio (ver .gitignore).
# ==========================================================

# --- Servidor ---
PORT=3000

# Clave para firmar las sesiones (JWT). Mínimo 32 caracteres, aleatoria.
# Puedes generar una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA=2h

# Direcciones desde donde se abre el frontend (separadas por coma)
CORS_ORIGENES=http://localhost:5502,http://127.0.0.1:5502

# --- Oracle ---
ORACLE_USER=
ORACLE_PASSWORD=

# Una de estas opciones:
#  - Nombre de servicio de tu tnsnames.ora (Autonomous Database: ej. minombre_high)
#  - Easy Connect:  host:1521/nombre_del_servicio
ORACLE_CONNECT_STRING=

# Solo si usas Oracle Autonomous Database con cartera (wallet):
# carpeta descomprimida de la cartera (contiene tnsnames.ora y ewallet.pem)
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=

# Esquema dueño de las tablas. El script indica ADMIN.
# Si te conectas con el mismo usuario dueño de las tablas, puedes dejarlo vacío.
ORACLE_SCHEMA=ADMIN

# ==========================================================
# Sprint 4 (opcionales: si no las pones, se usan estos valores)
# ==========================================================

# #29 Logs: carpeta (por defecto backend/logs) y cuántos días se conservan.
# LOG_ARCHIVO=0 desactiva los archivos (la auditoría en Oracle sigue funcionando).
#LOG_DIR=
LOG_DIAS=30
#LOG_ARCHIVO=0

# #27 Monitoreo: una solicitud más lenta que esto (en milisegundos) se registra como "lenta"
MONITOREO_UMBRAL_MS=1000

# #32 Pasarela de pagos (Webpay Plus de Transbank)
#   simulado  = pantalla de pago falsa para desarrollo (NO sirve en producción)
#   transbank = Webpay real: TBK_AMBIENTE=integracion (pruebas, sin dinero) o produccion (dinero real)
PAGOS_PROVEEDOR=simulado
TBK_AMBIENTE=integracion
# En integración se usan las credenciales públicas de prueba de Transbank si no pones nada.
# En producción son obligatorias (las entrega Transbank al validar tu comercio).
#TBK_COMMERCE_CODE=
#TBK_API_KEY=
# Dirección pública del backend: Webpay devuelve al cliente aquí. En producción debe ser https://
BACKEND_PUBLIC_URL=http://localhost:3000
# Dirección donde se abre el frontend (a donde se vuelve después de pagar)
FRONTEND_URL=http://localhost:5502
PAGOS_EXPIRA_MINUTOS=30

# #30 Respaldo: cada cuántas horas se respalda solo (0 = desactivado) y cuántos respaldos se guardan
RESPALDO_CADA_HORAS=24
RESPALDO_MAX=7
#RESPALDO_DIR=
